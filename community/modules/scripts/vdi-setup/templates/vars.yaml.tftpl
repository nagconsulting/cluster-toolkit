# Generated by Cluster Toolkit

deployment_name: ${deployment_name}
project_id:      ${project_id}
user_provision:  ${user_provision}
vnc_flavor:      ${vnc_flavor}
vdi_tool:        ${vdi_tool}
vdi_user_group:  ${vdi_user_group}
vdi_webapp_port: ${vdi_webapp_port}
vdi_resolution:  ${vdi_resolution}

vdi_users:
%{ for u in vdi_users }
  - username: ${u.username}
    port:     ${u.port}
%{ if u.password != null }
    password: "${u.password}"
%{ else }
    %{ if u.secret_name != null }
    secret_name: "${u.secret_name}"
    %{ endif }
%{ endif }
%{ endfor }
